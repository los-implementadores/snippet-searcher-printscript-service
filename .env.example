# Copy this file to .env and fill it in. .env is git-ignored.
# Both ./gradlew bootRun (spring.config.import in application.yml) and docker compose read it.

# Auth0 tenant, with scheme and trailing slash: https://<tenant>.us.auth0.com/
AUTH_ISSUER_URI=
# Identifier of the Auth0 API (the token's "aud")
AUTH_AUDIENCE=

# Ports on your machine. Change them to run several services at once.
PORT=8080
DB_PORT=5432

# Origins allowed to call the API from a browser, comma separated (the Vite dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# New Relic, only used by the Docker image. Leave it off locally unless you are testing it.
NEW_RELIC_AGENT_ENABLED=false
NEW_RELIC_LICENSE_KEY=
